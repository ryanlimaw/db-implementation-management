# Conexão com o MongoDB (local, sem autenticação neste exemplo)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=cartola_fc_db

# Endpoint principal do enunciado (atletas, clubes, posicoes, status)
CARTOLA_API_URL=https://api.cartola.globo.com/atletas/mercado
# Endpoint com o status do mercado (rodada_atual, status_mercado, fechamento...)
CARTOLA_STATUS_URL=https://api.cartola.globo.com/mercado/status

# Tempo máximo de espera de cada requisição (segundos)
REQUEST_TIMEOUT=30
