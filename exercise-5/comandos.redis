ECHO "== Ex01 - Strings: SET/GET =="
SET sistema:nome "DataPlatform"
GET sistema:nome
ECHO "== Ex02 - Strings: MSET/MGET =="
MSET env:db "postgres" env:cache "redis" env:queue "rabbitmq"
MGET env:db env:cache
ECHO "== Ex03 - Strings: SETEX/TTL =="
SETEX sessao:usuario:101 30 "xyz123"
TTL sessao:usuario:101
ECHO "== Ex04 - Strings: contador =="
INCR pageviews:home
INCRBY pageviews:home 5
DECRBY pageviews:home 2
ECHO "== Ex05 - Hashes: HSET =="
HSET usuario:201 nome "Carlos" email "carlos@email.com" nivel "admin"
ECHO "== Ex06 - Hashes: HGET/HGETALL =="
HGET usuario:201 email
HGETALL usuario:201
ECHO "== Ex07 - Hashes: HINCRBY/HKEYS =="
HINCRBY usuario:201 tentativas_login 1
HKEYS usuario:201
ECHO "== Ex08 - Lists: RPUSH =="
RPUSH fila:email "email_1" "email_2" "email_3"
ECHO "== Ex09 - Lists: LPOP (FIFO) =="
LPOP fila:email
ECHO "== Ex10 - Lists: LRANGE =="
LRANGE fila:email 0 -1
ECHO "== Ex11 - Sets: SADD/SCARD =="
SADD tags:post:1 "dados" "redis" "nosql" "redis"
SCARD tags:post:1
ECHO "== Ex12 - Sets: SINTER =="
SADD tags:post:2 "redis" "python" "backend"
SINTER tags:post:1 tags:post:2
ECHO "== Ex13 - Sets: SISMEMBER =="
SISMEMBER tags:post:1 "python"
ECHO "== Ex14 - Sorted Sets: ZADD =="
ZADD placar:game 1500 "alice" 2200 "bob" 1800 "carol"
ECHO "== Ex15 - Sorted Sets: ZREVRANGE =="
ZREVRANGE placar:game 0 -1 WITHSCORES
ECHO "== Ex16 - Sorted Sets: ZINCRBY/ZREVRANK =="
ZINCRBY placar:game 800 "alice"
ZREVRANK placar:game "alice"
ECHO "== Ex17 - Pub/Sub: o SUBSCRIBE bloqueia o terminal, entao precisa ser feito em OUTRO terminal ANTES deste script: redis-cli SUBSCRIBE notificacoes =="
ECHO "Sem assinante ativo o PUBLISH abaixo retorna 0; com o assinante do outro terminal retorna 1"
PUBLISH notificacoes "Novo relatorio disponivel"
ECHO "== Ex18 - Transacao: saldos iniciais + MULTI/EXEC =="
SET conta:A 100
SET conta:B 0
MULTI
DECRBY conta:A 50
INCRBY conta:B 50
EXEC
MGET conta:A conta:B
ECHO "== Ex19 - Administracao: EXISTS/RENAME/DEL =="
EXISTS sistema:nome
RENAME sistema:nome sistema:app
DEL sistema:app
ECHO "== Ex20 - Administracao: INFO memory/FLUSHDB (apaga so o banco 1) =="
INFO memory
FLUSHDB
DBSIZE
