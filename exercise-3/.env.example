# Conexão com o MongoDB (local ou Atlas)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ubs_geo
MONGO_COLLECTION=ubs

# API de dados abertos do Ministério da Saúde
UBS_API_URL=https://apidadosabertos.saude.gov.br/assistencia-a-saude/unidade-basicas-de-saude
# Registros por página (a API devolve no máximo 1000 por requisição)
UBS_PAGE_SIZE=1000
# Máximo de registros a baixar (0 = baixar a base inteira)
UBS_MAX_REGISTROS=0
# Pausa entre páginas, em segundos
UBS_PAUSA=0.3
